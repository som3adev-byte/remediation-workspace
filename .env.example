# Copy to .env and replace every "change-me" value. Never commit .env.

# Postgres superuser used only by docker compose to bootstrap roles and databases.
POSTGRES_PASSWORD=change-me-superuser
# Owner role: runs migrations, seed and test resets.
APP_OWNER_PASSWORD=change-me-owner
# Runtime role: no table ownership, no BYPASSRLS, subject to row-level security.
APP_USER_PASSWORD=change-me-user

DATABASE_URL=postgresql://app_user:change-me-user@localhost:55432/remediation
MIGRATION_DATABASE_URL=postgresql://app_owner:change-me-owner@localhost:55432/remediation
TEST_DATABASE_URL=postgresql://app_user:change-me-user@localhost:55432/remediation_test
TEST_MIGRATION_DATABASE_URL=postgresql://app_owner:change-me-owner@localhost:55432/remediation_test

# Token signing. At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-at-least-32-random-bytes-xxxxxxxxxxxx
JWT_ISSUER=remediation-workspace-api
JWT_AUDIENCE=remediation-workspace-web

# Shared secret the web proxy sends so the API only accepts traffic that came through it.
PROXY_SECRET=change-me-proxy-secret-at-least-32-bytes-xxxxxxxx

# Browser origin allowed to make state-changing requests.
WEB_ORIGIN=http://localhost:3100
# Production only: the header your load balancer sets with the client IP (e.g. x-forwarded-for).
# Leave unset locally: then a browser-sent header is never trusted and all sign-ins share one per-IP counter.
# TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
API_PORT=4000
API_URL=http://127.0.0.1:4000

# Password for every seeded demo account (local only).
SEED_PASSWORD=change-me-demo-password
