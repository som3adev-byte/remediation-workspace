{
  "name": "@rw/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file=../../.env --watch dist/main.js",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:setup": "dotenv -e ../../.env -- sh -c 'prisma migrate deploy && prisma generate && tsx prisma/seed.ts'",
    "db:setup:test": "dotenv -e ../../.env -- sh -c 'DATABASE_URL=$TEST_DATABASE_URL MIGRATION_DATABASE_URL=$TEST_MIGRATION_DATABASE_URL prisma migrate deploy && prisma generate'",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "@rw/shared": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jose": "6.2.13",
    "pino": "9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  }
}
